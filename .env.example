# GEMINI_API_KEY: Obavezan server-side ključ za Gemini AI API pozive.
# Nikada ne stavljaj ovaj ključ u frontend kod (bez VITE_ prefiksa).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Opcioni izbor zvaničnog Gemini modela.
# Podrazumevani model je gemini-3.5-flash-lite.
GEMINI_MODEL="gemini-3.5-flash-lite"

# QUOTA_HMAC_SECRET: Tajni ključ za potpisivanje first-party kolačića uređaja (preporučeno na produkciji).
QUOTA_HMAC_SECRET="replace-with-random-64-char-secret"

# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN (ili KV_REST_API_URL / KV_REST_API_TOKEN):
# Trajno atomsko serversko skladište za dnevni limit (3 pitanja dnevno, reset u ponoć Europe/Belgrade).
# Obavezno za Vercel / serverless okruženja radi pouzdanog očuvanja limita između instanci.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# APP_URL: URL na kojem je aplikacija hostovana.
APP_URL="http://localhost:3000"
